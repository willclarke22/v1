import { NextResponse } from "next/server";
import { DEFAULT_OPENAI_MODEL, callResponses, num, parseJson, record, text } from "../_shared";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type EvaluateRequest = {
  model?: string;
  learner_message?: string;
  diagnosis?: unknown;
  probe?: unknown;
  attempt?: unknown;
  probe_evidence_context?: unknown;
  topic_state?: unknown;
  personalization_context?: unknown;
  recent_history?: unknown[];
};

function bool(value: unknown, fallback = false) {
  return typeof value === "boolean" ? value : fallback;
}

function allowed(value: unknown, options: readonly string[], fallback: string) {
  return typeof value === "string" && options.includes(value) ? value : fallback;
}

function normalizeEvaluation(value: unknown) {
  const r = record(value);
  const e = record(r.understanding_evidence);
  const feedback = record(r.learner_feedback);
  const confusion = record(r.confusion_judgment);
  const insight = record(r.insight_judgment);
  const delta = record(r.metric_delta);
  const bandwidth = record(r.probe_evidence_assessment);

  return {
    schema_version: "probe_attempt_evaluator_output_v1",
    correctness: num(r.correctness, 0),
    correctness_summary: text(r.correctness_summary, "The attempt was evaluated against the delivered probe.", 700),
    probe_evidence_assessment: {
      evidence_bandwidth: text(bandwidth.evidence_bandwidth, "medium", 80),
      scoring_note: text(bandwidth.scoring_note, "Judge only what the delivered probe actually asked for.", 700),
      capped_evidence_strength: num(bandwidth.capped_evidence_strength, num(e.evidence_strength, 0.4)),
    },
    understanding_evidence: {
      evidence_strength: num(e.evidence_strength, 0.4),
      supports_understanding: bool(e.supports_understanding),
      supports_gap: bool(e.supports_gap),
      may_be_lucky_guess: bool(e.may_be_lucky_guess),
      possible_guess: bool(e.possible_guess),
      needs_verification_probe: bool(e.needs_verification_probe, true),
      informational_only: bool(e.informational_only),
      verification_reason: typeof e.verification_reason === "string" ? e.verification_reason.slice(0, 500) : null,
    },
    misconception_hits: Array.isArray(r.misconception_hits)
      ? r.misconception_hits.map((hit, index) => {
          const h = record(hit);
          return {
            misconception_id: text(h.misconception_id, `misconception_${index + 1}`, 80),
            label: typeof h.label === "string" ? h.label.slice(0, 160) : null,
            confidence: num(h.confidence, 0.5),
          };
        }).slice(0, 8)
      : [],
    diagnosis_delta: record(r.diagnosis_delta),
    confusion_judgment: {
      score: num(confusion.score, 0.45),
      rubric_anchor: text(confusion.rubric_anchor, "noticeable confusion", 120),
      evidence: text(confusion.evidence, "The evaluator judged the learner's remaining confusion from the attempt.", 700),
      confidence: num(confusion.confidence, 0.55),
    },
    insight_judgment: {
      score: num(insight.score, 0.2),
      rubric_anchor: text(insight.rubric_anchor, "slight engagement", 120),
      evidence: text(insight.evidence, "The evaluator judged the learner's insight from the attempt.", 700),
      confidence: num(insight.confidence, 0.55),
    },
    metric_delta: {
      confusion_delta: num(delta.confusion_delta, 0),
      insight_delta: num(delta.insight_delta, 0),
      mastery_delta: num(delta.mastery_delta, 0),
      evidence_count_delta: Math.max(0, Math.floor(num(delta.evidence_count_delta, 1))),
      verification_needed: bool(delta.verification_needed, bool(e.needs_verification_probe, true)),
      reason: text(delta.reason, "The sandbox applied a cautious update from the attempt evidence.", 700),
    },
    personalization_delta: r.personalization_delta ?? null,
    next_action: allowed(
      r.next_action,
      ["give_feedback", "target_misconception", "generate_followup_probe", "ask_clarifying_question", "summarize_progress"],
      "give_feedback",
    ),
    next_action_confidence: num(r.next_action_confidence, 0.65),
    learner_feedback: {
      reply: text(feedback.reply, "Thanks — MyWay checked your response and can use it to choose the next probe.", 900),
      suggested_next_step: text(feedback.suggested_next_step, "Try one follow-up probe to verify the idea.", 600),
    },
  };
}

function systemPrompt() {
  return [
    "You are MyWay's Probe Attempt Evaluator and brain-update judge.",
    "Return ONLY valid JSON. No markdown. No comments. No code fences.",
    "Judge the learner attempt against the delivered probe, answer key, and misconception markers.",
    "Use the confusion and insight rubrics exactly and cite the evidence from the attempt.",
    "Be cautious: one correct answer can reduce confusion but should not create full mastery unless the attempt shows stable understanding.",
    "Correct but thin selected-option answers may require verification.",
    "Do not criticize a learner for not giving an explanation if the delivered probe did not ask for an explanation.",
    "For single-choice or multi-choice probes, correctness can be high, but evidence strength should be capped as recognition evidence unless an explanation field was actually collected.",
    "Suggest personalization deltas only when there is actual outcome evidence, not because an interest exists.",
    "Use the rich personalization context to shape feedback and verification. Do not update interests unless the attempt shows the interest or teaching style helped or hurt.",
  ].join("\n");
}

function userPrompt(input: EvaluateRequest) {
  return [
    "Evaluate this MyWay probe attempt and produce smart metric deltas.",
    "",
    "Learner message:",
    input.learner_message ?? "",
    "",
    "Current topic state JSON:",
    JSON.stringify(input.topic_state ?? null, null, 2),
    "",
    "Personalization context JSON:",
    JSON.stringify(input.personalization_context ?? null, null, 2),
    "",
    "Recent history JSON:",
    JSON.stringify(input.recent_history ?? [], null, 2),
    "",
    "Diagnosis JSON:",
    JSON.stringify(input.diagnosis ?? null, null, 2),
    "",
    "Delivered probe JSON:",
    JSON.stringify(input.probe ?? null, null, 2),
    "",
    "Probe evidence context JSON:",
    JSON.stringify(input.probe_evidence_context ?? null, null, 2),
    "",
    "Learner attempt JSON:",
    JSON.stringify(input.attempt ?? null, null, 2),
    "",
    "Confusion rubric:",
    "0.0 complete clarity; 0.1 almost full clarity; 0.2 light uncertainty; 0.3 mild confusion; 0.4 noticeable confusion; 0.5 moderate confusion/incomplete model; 0.6 strong confusion; 0.7 significant confusion/major misinterpretations; 0.8 deep confusion; 0.9 severe confusion/close to giving up; 1.0 total confusion or frustration.",
    "",
    "Insight rubric:",
    "0.0 no insight; 0.1 extremely minimal curiosity; 0.2 slight factual follow-up; 0.3 basic noticing; 0.4 shallow connection; 0.5 clear realization; 0.6 reframing/analogy; 0.7 strong integration; 0.8 cross-domain integration; 0.9 breakthrough synthesis; 1.0 profound/original insight.",
    "",
    "Personalization update guidance:",
    "- A personalization_delta should be small, evidence-based, and scoped.",
    "- Prefer updates to explanation shape, probe type, feedback style, pacing, or verification behavior before updating interests.",
    "- Only update an interest if it actually improved or distracted from the probe.",
    "",
    "Evidence bandwidth rules:",
    "If expected_attempt_type is single_choice or multi_choice, do not say the learner failed to explain unless the UI asked them to explain. Say instead that the probe provides limited recognition evidence.",
    "For selected-option probes, cap evidence_strength around 0.55-0.70 for a correct answer unless there is separate reasoning text.",
    "Use needs_verification_probe when correctness is high but evidence bandwidth is low and the next step should check transfer/explanation.",
    "",
    "Delta guidance:",
    "- Strong correct attempt with reasoning: confusion -0.10 to -0.25, insight +0.12 to +0.28, mastery +0.10 to +0.22.",
    "- Correct but possible guess: confusion -0.02 to -0.06, insight +0.02 to +0.08, mastery +0.01 to +0.05, verification_needed true.",
    "- Incorrect with clear misconception: confusion +0.04 to +0.14, insight +0.00 to +0.05, mastery -0.04 to +0.00.",
    "- Thoughtful partial answer: confusion -0.02 to -0.10, insight +0.06 to +0.18, mastery +0.03 to +0.10.",
    "- Never claim total mastery from one probe.",
    "",
    "Return exactly this JSON shape:",
    "{",
    "  \"schema_version\": \"probe_attempt_evaluator_output_v1\",",
    "  \"correctness\": 0.0,",
    "  \"correctness_summary\": \"string\",",
    "  \"probe_evidence_assessment\": { \"evidence_bandwidth\": \"low|medium|high\", \"scoring_note\": \"how the probe type limits evidence\", \"capped_evidence_strength\": 0.0 },",
    "  \"understanding_evidence\": { \"evidence_strength\": 0.0, \"supports_understanding\": false, \"supports_gap\": false, \"may_be_lucky_guess\": false, \"possible_guess\": false, \"needs_verification_probe\": false, \"informational_only\": false, \"verification_reason\": null },",
    "  \"misconception_hits\": [{ \"misconception_id\": \"string\", \"label\": \"string or null\", \"confidence\": 0.0 }],",
    "  \"diagnosis_delta\": {},",
    "  \"confusion_judgment\": { \"score\": 0.0, \"rubric_anchor\": \"anchor\", \"evidence\": \"specific evidence\", \"confidence\": 0.0 },",
    "  \"insight_judgment\": { \"score\": 0.0, \"rubric_anchor\": \"anchor\", \"evidence\": \"specific evidence\", \"confidence\": 0.0 },",
    "  \"metric_delta\": { \"confusion_delta\": 0.0, \"insight_delta\": 0.0, \"mastery_delta\": 0.0, \"evidence_count_delta\": 1, \"verification_needed\": false, \"reason\": \"why\" },",
    "  \"personalization_delta\": null,",
    "  \"next_action\": \"give_feedback|target_misconception|generate_followup_probe|ask_clarifying_question|summarize_progress\",",
    "  \"next_action_confidence\": 0.0,",
    "  \"learner_feedback\": { \"reply\": \"learner-facing feedback\", \"suggested_next_step\": \"one concrete next step\" }",
    "}",
    "Return JSON only.",
  ].join("\n");
}

export async function POST(request: Request) {
  const startedAt = Date.now();
  const body = (await request.json().catch(() => ({}))) as EvaluateRequest;
  const model = body.model?.trim() || DEFAULT_OPENAI_MODEL;

  try {
    const content = await callResponses({
      model,
      system: systemPrompt(),
      user: userPrompt(body),
      maxOutputTokens: 4600,
    });
    return NextResponse.json({
      ok: true,
      model,
      elapsed_ms: Date.now() - startedAt,
      output: normalizeEvaluation(parseJson(content)),
      raw_output_preview: content.slice(0, 2200),
    });
  } catch (error) {
    const message = error instanceof Error ? error.message : "Unknown OpenAI evaluate error";
    console.error("[myway-openai-full-loop/evaluate]", message);
    return NextResponse.json({ ok: false, model, elapsed_ms: Date.now() - startedAt, error: message }, { status: 500 });
  }
}
