// -----------------------------------------------------------------------------
// MyWay OpenAI Full Loop: Visual Story Prompt Contract
// -----------------------------------------------------------------------------
//
// This prompt contract asks the generator to produce a scene-first visual story
// contract. The orientation paragraph is the source of truth. The model should
// not create recap bullets or a second staging paragraph that becomes the real
// animation source.

export const VISUAL_STORY_PROMPT_CONTRACT_V1 = [
  "SCENE-FIRST VISUAL STORY CONTRACT V1:",
  "Use this contract when the learner needs an orientation-first visual bridge, especially for purpose/intuition questions where a cold quiz would be unfair.",
  "For compatibility today, use probe.probe_type video_explanation and probe.expected_attempt_type text, then put the real scene-first contract in probe.renderer_params.visual_story.",
  "renderer_params.visual_story.schema_version must be myway_visual_story_renderer_v1 and renderer_params.visual_story.scene_kind must be visual_story.",
  "The orientation script is the source of truth. The scene, objects, camera moves, transformations, and interaction phase must be derived from story.orientation_script.",
  "Do not create a separate staging paragraph. Do not create recap bullets. Do not add a supporting_takeaways list. Do not append a Think of... summary as a second teaching script.",
  "If a short final check is useful, put it in optional_check, not in story.orientation_script.",
  "story.orientation_script should be one coherent learner-facing paragraph. It can contain examples when they genuinely help the explanation, but it should not end with bullet points.",
  "If story.orientation_script explicitly mentions examples such as sound, engines, wheels, tides, seasons, waves, signals, or any other real-world object, include matching entries in story.visual_semantics.supporting_examples and include visual actions/beats for them when possible.",
  "Do not force examples that were not mentioned in story.orientation_script. The visual plan follows the words; it does not decorate them randomly.",
  "Required visual_story shape:",
  "{ schema_version: myway_visual_story_renderer_v1, scene_kind: visual_story, story: { orientation_script, title, root_problem_focus, target_takeaway, visual_semantics, beats, scene_defaults, script_display }, interaction_phase, optional_check, compatibility mirror fields }",
  "story.visual_semantics.key_entities must list the core things that should be visible, such as wheel, dot, graph_2d, wave, circle_arc, label, axis, surface, point, vector, machine, particle, flow, container, token, or custom.",
  "Each key entity needs id, kind, semantic_role, optional display_name, and optional meaning. Use stable ids that actions and beats can reference.",
  "story.visual_semantics.key_relationships must state important visible relationships using relationship_type maps_to, drives, corresponds_to, becomes, traces, controls, contrasts_with, explains, or is_example_of.",
  "story.visual_semantics.key_transformations must state important motions/mappings using trace_motion, unwrap_motion_into_graph, build_expression_piece_by_piece, highlight_slice, morph_shape, compare_examples, expand_to_related_examples, show_cause_effect, or camera_reveal.",
  "story.beats must split story.orientation_script into exact or near-exact script_segment slices. Each beat should have id, script_segment, duration_ms, active_entity_ids, actions, and optionally camera/text_overlay.",
  "Do not simplify beat text into a separate staging sentence. script_segment should be the learner-facing words being performed by the scene.",
  "story.script_display should usually be { show_full_script: true, reveal_mode: beat_synced, layout: bottom_caption or side_panel, max_visible_segments: 1 or 2, animate_text: true }.",
  "The visual actions should be scene-first: show_entity, animate_entity, rotate_entity, trace_path, draw_graph, highlight_entity, highlight_relationship, show_marker, morph_entity, spawn_example, transition_to_example, or pause_emphasis.",
  "The story should first guide with autoplay, then unlock actual exploration. interaction_phase.controls should usually include orbit, zoom, pan, replay, pause, and at least one meaningful manipulator when the scene is spatial or motion-based.",
  "Interactive does not mean only buttons. Prefer manipulators like drag_point, scrub_phase, slider_parameter, toggle_example, toggle_projection, switch_view, or play_pause_motion that let the learner manipulate the same scene objects used in the story.",
  "For trigonometry purpose questions, a good plan is: wheel/dot circular motion, pi and 2pi turn markers, height/sideways tracking, graph unwrapping into a timeline, and optional visual echoes only for real examples actually mentioned in the orientation script.",
  "For trig, include key_transformations such as trace_motion and unwrap_motion_into_graph. If sound/engines/tides/seasons are mentioned, include supporting_examples and beats/actions that visually connect those examples back to the same repeating pattern.",
  "For other subjects, use the same general schema. Do not fall back to a text-only explanation when a scene can make the hidden relationship visible.",
  "Temporary compatibility mirror requirement for the current VisualStoryProbe renderer:",
  "Also include top-level canonical_orientation_script equal to story.orientation_script, title, learning_goal equal to story.target_takeaway, scene_family, script_beats, scene_objects, scene_actions, camera_plan, interaction_phase, and success_criteria.",
  "Top-level script_beats must mirror story.beats using script_text equal to script_segment. This keeps the current renderer showing the real script while the renderer migrates to story.beats directly.",
  "Top-level scene_objects should be a procedural object list. Supported current renderer types include wheel, dot, arc, axis, graph, wave, line, guide_line, arrow, label, point, vector, surface, plane, slice, bar, container, token, flow_path, node, connector, highlight, and generic.",
  "Top-level scene_actions should map beats to visible actions. Supported action words include show, hide, fade, move, rotate, spin, trace, draw, grow, morph, pulse, highlight, connect, project, map_motion_to_graph, label, focus, unlock_interaction, spawn_example, and transition_to_example.",
  "Top-level camera_plan should describe smooth camera motion using hold, push_in, pull_back, orbit, pan, tilt, reframe, follow_object, or wide_reveal.",
  "Do not output markdown inside JSON strings. Return one valid JSON object only.",
] as const;
