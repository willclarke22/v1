const fs = require("fs");
const path = require("path");

const archiveRoot = path.join("archive", "visual-story-backups", "app-sandbox-probe-lab-routes");
const manifestPath = path.join(archiveRoot, "move-probe-lab-routes-under-app-sandbox-manifest.txt");

const moves = [
  {
    from: path.join("app", "probe-lab"),
    to: path.join("app", "sandbox", "probe-lab"),
    label: "app-probe-lab",
  },
  {
    from: path.join("app", "api", "probe-lab"),
    to: path.join("app", "api", "sandbox", "probe-lab"),
    label: "app-api-probe-lab",
  },
];

function ensureDir(dir) {
  fs.mkdirSync(dir, { recursive: true });
}

function read(file) {
  return fs.readFileSync(file, "utf8");
}

function write(file, text) {
  ensureDir(path.dirname(file));
  fs.writeFileSync(file, text, "utf8");
}

function copyDir(src, dest) {
  ensureDir(dest);

  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
    const srcPath = path.join(src, entry.name);
    const destPath = path.join(dest, entry.name);

    if (entry.isDirectory()) {
      copyDir(srcPath, destPath);
    } else {
      fs.copyFileSync(srcPath, destPath);
    }
  }
}

function removeDir(dir) {
  fs.rmSync(dir, { recursive: true, force: true });
}

function walk(dir, files = []) {
  if (!fs.existsSync(dir)) return files;

  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (
      entry.name === "node_modules" ||
      entry.name === ".next" ||
      entry.name === ".git" ||
      entry.name === "archive"
    ) {
      continue;
    }

    const fullPath = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      walk(fullPath, files);
    } else if (/\.(ts|tsx|js|jsx|cjs|mjs|json|md)$/.test(entry.name)) {
      files.push(fullPath);
    }
  }

  return files;
}

function backupDir(src, label) {
  if (!fs.existsSync(src)) return null;
  const dest = path.join(archiveRoot, `${label}.before-app-sandbox-route-move`);
  removeDir(dest);
  copyDir(src, dest);
  return dest;
}

function backupFile(file, label) {
  ensureDir(archiveRoot);
  const safe = label.replace(/[\\/:*?"<>|]/g, "__");
  const backupPath = path.join(archiveRoot, safe);
  fs.copyFileSync(file, backupPath);
  return backupPath;
}

function fail(message) {
  console.error(message);
  process.exit(1);
}

ensureDir(archiveRoot);

const moved = [];
const alreadyMoved = [];
const backups = [];
const changed = [];

for (const item of moves) {
  const fromExists = fs.existsSync(item.from);
  const toExists = fs.existsSync(item.to);

  if (fromExists && toExists) {
    fail(`Both source and destination exist. Stop to avoid merging accidentally:\n  source: ${item.from}\n  destination: ${item.to}`);
  }

  if (fromExists) {
    const backupPath = backupDir(item.from, item.label);
    if (backupPath) backups.push(backupPath);

    ensureDir(path.dirname(item.to));
    copyDir(item.from, item.to);
    removeDir(item.from);
    moved.push(`${item.from} -> ${item.to}`);
  } else if (toExists) {
    alreadyMoved.push(item.to);
  } else {
    fail(`Missing both source and destination for ${item.label}`);
  }
}

const replacements = [
  ['"/api/probe-lab', '"/api/sandbox/probe-lab'],
  ["'/api/probe-lab", "'/api/sandbox/probe-lab"],
  ["`/api/probe-lab", "`/api/sandbox/probe-lab"],
  ['"/probe-lab', '"/sandbox/probe-lab'],
  ["'/probe-lab", "'/sandbox/probe-lab"],
  ["`/probe-lab", "`/sandbox/probe-lab"],
];

for (const file of walk(".")) {
  const before = read(file);
  let next = before;

  for (const [from, to] of replacements) {
    next = next.split(from).join(to);
  }

  if (next !== before) {
    backups.push(backupFile(file, `${file}.before-app-sandbox-url-rewrite.bak`));
    write(file, next);
    changed.push(file);
  }
}

const manifest = [
  "MYWAY MOVE PROBE LAB ROUTES UNDER APP SANDBOX",
  `Generated: ${new Date().toISOString()}`,
  "",
  "Goal:",
  "- Make active Next.js sandbox routes visibly live under app/sandbox and app/api/sandbox.",
  "- Keep root sandbox/probe-lab as the implementation/source home.",
  "- Avoid leaving app/probe-lab and app/api/probe-lab route folders in the main route namespace.",
  "",
  "Moved:",
  ...moved.map((item) => `- ${item}`),
  "",
  "Already moved:",
  ...alreadyMoved.map((item) => `- ${item}`),
  "",
  "Updated URL strings in:",
  ...changed.map((file) => `- ${file}`),
  "",
  "Backups:",
  ...backups.map((item) => `- ${item}`),
  "",
  "New URLs:",
  "- /sandbox/probe-lab",
  "- /sandbox/probe-lab/openai-full-loop",
  "- /api/sandbox/probe-lab/openai-full-loop/generate",
  "- /api/sandbox/probe-lab/openai-full-loop/evaluate",
  "- /api/sandbox/probe-lab/openai-full-loop/generate-image",
  "- /api/sandbox/probe-lab/openai-full-loop/relationships",
  "",
  "Note:",
  "- /probe-lab and /api/probe-lab will no longer exist unless we intentionally add redirect bridge routes later."
].join("\n");

write(manifestPath, manifest);

console.log("Probe lab routes moved under app/sandbox.");
console.log(`Moved: ${moved.length}`);
console.log(`Changed URL files: ${changed.length}`);
console.log(`Manifest: ${manifestPath}`);
