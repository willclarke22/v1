  },
  {
    id: "graph-height",
    title: "Motion becomes a graph",
    script_text: "Graphing that height over time turns the motion into a smooth repeating wave.",
    purpose: "mapping",
    visual_goal: "Draw the wave from the tracked height.",
    duration_ms: 6800,
    focus_object_ids: ["height_wave"],
    action_ids: ["draw_wave", "highlight_period", "highlight_peak"],
  },
];

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function readString(value: unknown, fallback: string, max = 1200) {
  return typeof value === "string" && value.trim()
    ? value.trim().slice(0, max)
    : fallback;
}

function readOptionalString(value: unknown, max = 1200) {
  return typeof value === "string" && value.trim()
    ? value.trim().slice(0, max)
    : null;
}

function readNumber(value: unknown, fallback: number, min = 800, max = 16000) {
  const numberValue = typeof value === "number" ? value : Number(value);
  return Number.isFinite(numberValue)
    ? Math.min(max, Math.max(min, numberValue))
    : fallback;
}

function readStringArray(value: unknown, fallback: string[] = [], max = 16) {
  if (!Array.isArray(value)) return fallback;
  return value
    .filter((item): item is string => typeof item === "string" && item.trim().length > 0)
    .map((item) => item.trim().slice(0, 90))
    .slice(0, max);
}

function sanitizeId(value: unknown, fallback: string) {
  const raw = typeof value === "string" && value.trim() ? value.trim() : fallback;
  const cleaned = raw
    .toLowerCase()
    .replace(/[^a-z0-9_\-\s]/g, "")
    .replace(/\s+/g, "_")
    .slice(0, 72);
  return cleaned || fallback;
}

function tuple3(value: unknown): [number, number, number] | null {
  if (!Array.isArray(value) || value.length < 2) return null;
  const x = Number(value[0]);
  const y = Number(value[1]);
  const z = Number(value[2] ?? 0);
  return Number.isFinite(x) && Number.isFinite(y) && Number.isFinite(z) ? [x, y, z] : null;
}

function clamp(value: number, min = 0, max = 1) {
  return Math.min(max, Math.max(min, value));
}

function easeInOut(value: number) {
  const t = clamp(value);
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

function splitCanonicalScript(script: string): string[] {
  const normalized = script.replace(/\s+/g, " ").trim();
  if (!normalized) return DEFAULT_SCRIPT_BEATS.map((beat) => beat.script_text);

  const sentenceMatches = normalized.match(/[^.!?]+[.!?]+|[^.!?]+$/g) ?? [normalized];
  const sentences = sentenceMatches.map((sentence) => sentence.trim()).filter(Boolean);

  const beats: string[] = [];
  let current = "";

  for (const sentence of sentences) {
    const next = current ? `${current} ${sentence}` : sentence;
    if (next.length > 210 && current) {
      beats.push(current);
      current = sentence;
    } else {
      current = next;
    }
  }

  if (current) beats.push(current);
  return beats.slice(0, 7);
}

function purposeFromText(text: string, index: number): VisualStoryPurpose {
  const lower = text.toLowerCase();
  if (index === 0) return "setup";
  if (/real life|wheels|engines|sound|seasons|signals|matters|because/.test(lower)) return "real_life_relevance";
  if (/graph|timeline|pattern|wave|shows|measure/.test(lower)) return "mapping";
  if (/pi|π|2π|turn|half|full/.test(lower)) return "measurement";
  if (/sine|cosine|sin|cos|track|height|sideways/.test(lower)) return "mechanism";
  return "mechanism";
}

function titleFromText(text: string, index: number) {
  const clean = text.replace(/["“”]/g, "").trim();
  const words = clean.split(/\s+/).slice(0, 5).join(" ");
  return words || `Beat ${index + 1}`;
}

function normalizeScriptBeats(rawStory: Record<string, unknown>, canonicalScript: string): VisualScriptBeat[] {
  const source = Array.isArray(rawStory.script_beats)
    ? rawStory.script_beats
    : Array.isArray(rawStory.orientation_segments)
      ? rawStory.orientation_segments
      : Array.isArray(rawStory.beats)
        ? rawStory.beats
        : [];

  const normalized = source
    .map((item, index): VisualScriptBeat | null => {
      const beat = isRecord(item) ? item : {};
      const scriptText = readString(
        beat.script_text ?? beat.orientation_text ?? beat.exact_text ?? beat.words ?? beat.text ?? beat.narration,
        "",
        900,
      );
      if (!scriptText) return null;
      const id = sanitizeId(beat.id, `script_beat_${index + 1}`);
      return {
        id,
        title: readString(beat.title, titleFromText(scriptText, index), 120),
        script_text: scriptText,
        display_text: readOptionalString(beat.display_text, 600),
        purpose: readString(beat.purpose, purposeFromText(scriptText, index), 80),
        visual_goal: readString(beat.visual_goal ?? beat.visualGoal, "Make this sentence visible with motion and focus.", 360),
        duration_ms: readNumber(beat.duration_ms ?? beat.durationMs, 5400, 3200, 9000),
        focus_object_ids: readStringArray(beat.focus_object_ids ?? beat.focusObjectIds, [], 10).map((id) => sanitizeId(id, id)),
        action_ids: readStringArray(beat.action_ids ?? beat.actionIds, [], 12).map((id) => sanitizeId(id, id)),
      };
    })
    .filter((beat): beat is VisualScriptBeat => Boolean(beat))
    .slice(0, 8);

  if (normalized.length) return normalized;

  return splitCanonicalScript(canonicalScript).map((scriptText, index) => ({
    id: `script_beat_${index + 1}`,
    title: titleFromText(scriptText, index),
    script_text: scriptText,
    display_text: null,
    purpose: purposeFromText(scriptText, index),
    visual_goal: "Translate this exact sentence into a visible step.",
    duration_ms: index === 0 ? 4800 : 6000,
    focus_object_ids: [],
    action_ids: [],
  }));
}

function fallbackObjectsForScript(script: string, sceneFamily: string): VisualSceneObject[] {
  const lower = script.toLowerCase();
  const motionToGraph = sceneFamily === "motion_to_graph" || /wheel|circle|sine|cosine|sin|cos|pi|π|wave|turn/.test(lower);

  if (motionToGraph) {
    return [
      { id: "wheel", type: "wheel", role: "real_world_object", label: "turning wheel", position: [-2.55, 0.15, 0], visual_style: { emphasis: "primary" } },
      { id: "tracked_dot", type: "dot", role: "tracked_quantity", label: "tracked point", parent_id: "wheel", visual_style: { emphasis: "glow" } },
      { id: "turn_arc", type: "arc", role: "measurement_marker", label: "turn amount", parent_id: "wheel", visual_style: { emphasis: "warning" } },
      { id: "pi_label", type: "label", role: "measurement_marker", text: "π = half turn", position: [-2.55, 1.42, 0], visual_style: { emphasis: "warning" } },
      { id: "two_pi_label", type: "label", role: "measurement_marker", text: "2π = full turn", position: [-1.2, 1.42, 0], visual_style: { emphasis: "warning" } },
      { id: "height_guide", type: "guide_line", role: "relationship", label: "height", visual_style: { emphasis: "secondary" } },
      { id: "height_wave", type: "wave", role: "abstract_representation", label: "height over time", position: [0.3, -0.72, 0], visual_style: { emphasis: "primary" } },
    ];
  }

  return [
    { id: "real_anchor", type: "node", role: "real_world_object", label: "real example", position: [-2.4, 0.45, 0], visual_style: { emphasis: "primary" } },
    { id: "hidden_pattern", type: "node", role: "relationship", label: "hidden pattern", position: [0, 0.9, 0], visual_style: { emphasis: "glow" } },
    { id: "visible_model", type: "node", role: "abstract_representation", label: "visible model", position: [2.4, 0.45, 0], visual_style: { emphasis: "secondary" } },
    { id: "learner_target", type: "highlight", role: "learner_target", label: "your check", position: [0, -1.25, 0], visual_style: { emphasis: "success" } },
  ];
}

function normalizeSceneObjects(rawStory: Record<string, unknown>, canonicalScript: string, sceneFamily: string): VisualSceneObject[] {
  const rawObjects = Array.isArray(rawStory.scene_objects)
    ? rawStory.scene_objects
    : Array.isArray(rawStory.objects)
      ? rawStory.objects
      : [];

  const objects = rawObjects
    .map((item, index): VisualSceneObject | null => {
      const object = isRecord(item) ? item : {};
      const id = sanitizeId(object.id, `object_${index + 1}`);
      const type = readString(object.type, "generic", 60);
      return {
        id,
        type,
        role: readString(object.role, "abstract_representation", 90),
        label: readOptionalString(object.label, 120),
        text: readOptionalString(object.text, 180),
        parent_id: readOptionalString(object.parent_id ?? object.parentId, 90),
        position: tuple3(object.position),
        scale: tuple3(object.scale),
        initial_state: isRecord(object.initial_state ?? object.initialState)
          ? (object.initial_state ?? object.initialState) as VisualSceneObject["initial_state"]
          : null,
        visual_style: isRecord(object.visual_style ?? object.visualStyle)
          ? (object.visual_style ?? object.visualStyle) as VisualSceneObject["visual_style"]
          : null,
      };
    })
    .filter((object): object is VisualSceneObject => Boolean(object))
    .slice(0, 18);

  return objects.length ? objects : fallbackObjectsForScript(canonicalScript, sceneFamily);
}

function normalizeSceneActions(rawStory: Record<string, unknown>, scriptBeats: VisualScriptBeat[]): VisualSceneAction[] {
  const rawActions = Array.isArray(rawStory.scene_actions)
    ? rawStory.scene_actions
    : Array.isArray(rawStory.actions)
      ? rawStory.actions
      : [];

  const actions = rawActions
    .map((item, index): VisualSceneAction | null => {
      const action = isRecord(item) ? item : {};
      return {
        id: sanitizeId(action.id, `action_${index + 1}`),
        beat_id: sanitizeId(action.beat_id ?? action.beatId, scriptBeats[index % Math.max(1, scriptBeats.length)]?.id ?? "script_beat_1"),
        type: readString(action.type, "show", 70),
        target_id: readOptionalString(action.target_id ?? action.targetId ?? action.target, 90),
        from_id: readOptionalString(action.from_id ?? action.fromId ?? action.from, 90),
        to_id: readOptionalString(action.to_id ?? action.toId ?? action.to, 90),
        start_ms: typeof action.start_ms === "number" ? action.start_ms : undefined,
        duration_ms: readNumber(action.duration_ms ?? action.durationMs, 1800, 200, 12000),
        easing: readOptionalString(action.easing, 60),
        params: isRecord(action.params) ? action.params : null,
      };
    })
    .filter((action): action is VisualSceneAction => Boolean(action))
    .slice(0, 40);

  if (actions.length) return actions;

  return scriptBeats.flatMap((beat, index) => [
    { id: `${beat.id}_show`, beat_id: beat.id, type: "show", target_id: beat.focus_object_ids[0] ?? null, duration_ms: 900, params: null },
    { id: `${beat.id}_focus`, beat_id: beat.id, type: index % 2 === 0 ? "pulse" : "highlight", target_id: beat.focus_object_ids[0] ?? null, duration_ms: Math.max(1200, beat.duration_ms - 900), params: null },
  ]).slice(0, 18);
}

function normalizeCameraPlan(rawStory: Record<string, unknown>, scriptBeats: VisualScriptBeat[]): VisualCameraBeat[] {
  const rawCamera = Array.isArray(rawStory.camera_plan) ? rawStory.camera_plan : [];
  const cameraPlan = rawCamera
    .map((item, index): VisualCameraBeat | null => {
      const camera = isRecord(item) ? item : {};
      const view = isRecord(camera.view) ? camera.view : {};
      return {
        id: sanitizeId(camera.id, `camera_${index + 1}`),
        beat_id: sanitizeId(camera.beat_id ?? camera.beatId, scriptBeats[index % Math.max(1, scriptBeats.length)]?.id ?? "script_beat_1"),
        target_object_ids: readStringArray(camera.target_object_ids ?? camera.targetObjectIds, [], 8).map((id) => sanitizeId(id, id)),
        move: readString(camera.move, index % 3 === 0 ? "push_in" : index % 3 === 1 ? "reframe" : "wide_reveal", 60),
        duration_ms: readNumber(camera.duration_ms ?? camera.durationMs, 4800, 1200, 10000),
        easing: readOptionalString(camera.easing, 60),
        view: Object.keys(view).length
          ? {
              position: tuple3(view.position) ?? undefined,
              look_at: tuple3(view.look_at ?? view.lookAt) ?? undefined,
              zoom: typeof view.zoom === "number" ? view.zoom : undefined,
            }
          : null,
      };
    })
    .filter((camera): camera is VisualCameraBeat => Boolean(camera))
    .slice(0, 10);

  return cameraPlan.length
    ? cameraPlan
    : scriptBeats.map((beat, index) => ({
        id: `camera_${beat.id}`,
        beat_id: beat.id,
        target_object_ids: beat.focus_object_ids,
        move: index === 0 ? "push_in" : index === scriptBeats.length - 1 ? "wide_reveal" : "reframe",
        duration_ms: beat.duration_ms,
        easing: "ease_in_out",
        view: null,
      }));
}

function normalizeInteractionPhase(rawStory: Record<string, unknown>, sceneFamily: string): VisualInteractionPhase {
  const rawPhase = isRecord(rawStory.interaction_phase)
    ? rawStory.interaction_phase
    : isRecord(rawStory.learner_check)
      ? rawStory.learner_check
      : {};

  const rawRequired = Array.isArray(rawPhase.required_actions) ? rawPhase.required_actions : [];
  const defaultRequired = sceneFamily === "motion_to_graph"
    ? [
        { id: "scrub_motion", type: "scrub_motion", target_id: "wheel", success_marker: "learner_scrubbed_motion_and_saw_wave_update", label: "Scrub the motion" },
        { id: "mark_one_repeat", type: "mark_period", target_id: "height_wave", success_marker: "learner_identified_one_full_repeat", label: "Mark one repeat" },
        { id: "tap_peak", type: "select_peak", target_id: "height_wave", success_marker: "learner_identified_highest_point", label: "Tap highest point" },
      ]
    : [
        { id: "select_main_link", type: "select_point", target_id: "hidden_pattern", success_marker: "learner_selected_key_visual_link", label: "Select key link" },
        { id: "explain_visual", type: "write_short_explanation", target_id: "learner_target", success_marker: "learner_explained_visual_connection", label: "Confirm the connection" },
      ];

  const required = rawRequired
    .map((item, index): VisualRequiredAction | null => {
      const action = isRecord(item) ? item : {};
      const type = readString(action.type, index === 0 ? "select_point" : "write_short_explanation", 80);
      const id = sanitizeId(action.id, `required_action_${index + 1}`);
      return {
        id,
        type,
        target_id: readOptionalString(action.target_id ?? action.targetId ?? action.target, 90),
        success_marker: readString(action.success_marker ?? action.successMarker, id, 140),
        label: readString(action.label, labelForRequiredAction(type), 90),
      };
    })
    .filter((action): action is VisualRequiredAction => Boolean(action))
    .slice(0, 6);

  return {
    unlock_after: readString(rawPhase.unlock_after ?? rawPhase.unlockAfter, "animation_complete", 80),
    instructions: readString(
      rawPhase.instructions,
      sceneFamily === "motion_to_graph"
        ? "Mark one full repeat of the wave and tap the highest point."
        : "Use the scene to show which visual connection makes the idea click.",
      420,
    ),
    mode: readString(rawPhase.mode ?? rawPhase.kind, sceneFamily === "motion_to_graph" ? "mark" : "select", 80),
    required_actions: required.length ? required : defaultRequired,
    submit_when: readString(rawPhase.submit_when ?? rawPhase.submitWhen, "all_required_actions_complete", 80),
  };
}

function labelForRequiredAction(type: string) {
  if (type === "mark_period") return "Mark one repeat";
  if (type === "select_peak") return "Tap highest point";
  if (type === "drag_object") return "Drag the object";
  if (type === "scrub_motion") return "Scrub the motion";
  if (type === "connect_objects") return "Connect the objects";
  if (type === "write_short_explanation") return "Confirm the connection";
  return "Select the key part";
}

function normalizeSuccessCriteria(rawStory: Record<string, unknown>): VisualSuccessCriterion[] {
  const rawCriteria = Array.isArray(rawStory.success_criteria) ? rawStory.success_criteria : [];
  const criteria = rawCriteria
    .map((item, index): VisualSuccessCriterion | null => {
      const criterion = isRecord(item) ? item : {};
      const id = sanitizeId(criterion.id, `success_${index + 1}`);
      return {
        id,
        marker: readString(criterion.marker, id, 140),
        description: readOptionalString(criterion.description, 280),
      };
    })
    .filter((criterion): criterion is VisualSuccessCriterion => Boolean(criterion))
    .slice(0, 8);

  return criteria.length
    ? criteria
    : [{ id: "visual_link_understood", marker: "learner_used_scene_to_explain_the_link", description: "The learner used the animated scene to identify the key relationship." }];
}


function stripRecapText(script: string) {
  const original = script.replace(/\r/g, "").trim();
  if (!original) return script;

  let next = original;

  // Remove bullet/takeaway/recap sections. These can be useful elsewhere,
  // but they should not become the canonical animated teaching script.
  next = next.split(/\n\s*[•*-]\s+/)[0] ?? next;
  next = next.split(/\n\s*(?:think of|key takeaway|takeaways|recap|summary)\b/i)[0] ?? next;

  // Remove common generated staging paragraphs that describe the scene instead
  // of teaching the concept. The scene plan should live in scene_objects/actions.
  const stagingMarkers = [
    /\n\s*(?:A|The)\s+wheel\s+(?:with|spins|is|has)\b/i,
    /\n\s*(?:A|The)\s+horizontal\s+graph\b/i,
    /\n\s*The\s+scene\s+highlights\b/i,
    /\n\s*Labels\s+show\b/i,
    /\n\s*The\s+learner\s+then\b/i,
  ];

  for (const marker of stagingMarkers) {
    const match = next.match(marker);
    if (match?.index && match.index > 80) {
      next = next.slice(0, match.index).trim();
    }
  }

  const paragraphs = next
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

  if (paragraphs.length > 1) {
    const firstNonStaging = paragraphs.find((paragraph) => !/\b(scene|learner|labels|horizontal graph|glowing dot spins|is drawn beside)\b/i.test(paragraph));
    next = firstNonStaging ?? paragraphs[0];
  }

  next = next.replace(/\s+/g, " ").trim();
  return next || original.replace(/\s+/g, " ").trim();
}

const EXAMPLE_ECHO_LIBRARY: Array<{ pattern: RegExp; id: string; label: string; visual_metaphor: string; connection_to_core_pattern: string }> = [
  { pattern: /\bsound\b|\baudio\b|\bvibrat/i, id: "sound", label: "sound", visual_metaphor: "waveform", connection_to_core_pattern: "sound also rises and falls as a repeating wave" },
  { pattern: /\bengine\b|\bmotor\b/i, id: "engine", label: "engine", visual_metaphor: "cycle loop", connection_to_core_pattern: "engines repeat cycles of motion" },
  { pattern: /\btide\b|\bocean\b/i, id: "tides", label: "tides", visual_metaphor: "rising water level", connection_to_core_pattern: "tides rise and fall in repeating timing" },
  { pattern: /\bseason\b|\bdaylight\b/i, id: "seasons", label: "seasons", visual_metaphor: "year cycle", connection_to_core_pattern: "seasons repeat around a cycle" },
  { pattern: /\bsignal\b|\belectric\b/i, id: "signals", label: "signals", visual_metaphor: "oscillating signal", connection_to_core_pattern: "signals often repeat as measurable waves" },
  { pattern: /\bwheel\b|\btire\b/i, id: "wheels", label: "wheels", visual_metaphor: "turning circle", connection_to_core_pattern: "wheels turn, and one turn can become one repeat" },
  { pattern: /\bwave\b|\bwaves\b/i, id: "waves", label: "waves", visual_metaphor: "crest and trough", connection_to_core_pattern: "waves show highs, lows, and repeats" },
];

function normalizeExampleEchoes(rawStory: Record<string, unknown>, canonicalScript: string): VisualExampleEcho[] {
  const rawEchoes = Array.isArray(rawStory.example_echoes)
    ? rawStory.example_echoes
    : Array.isArray(rawStory.real_life_example_echoes)
      ? rawStory.real_life_example_echoes
      : [];

  const explicit = rawEchoes
    .map((item, index): VisualExampleEcho | null => {
      const echo = isRecord(item) ? item : {};
      const label = readOptionalString(echo.label ?? echo.source_text ?? echo.sourceText, 80);
      if (!label) return null;
      return {
        id: sanitizeId(echo.id, "example_echo_" + (index + 1)),
        label,
        source_text: readString(echo.source_text ?? echo.sourceText, label, 120),
        visual_metaphor: readString(echo.visual_metaphor ?? echo.visualMetaphor, "same repeating pattern", 140),
        connection_to_core_pattern: readString(echo.connection_to_core_pattern ?? echo.connectionToCorePattern, "This connects back to the same visual pattern.", 220),
      };
    })
    .filter((echo): echo is VisualExampleEcho => Boolean(echo))
    .slice(0, 6);

  if (explicit.length) return explicit;

  const found: VisualExampleEcho[] = [];
  for (const entry of EXAMPLE_ECHO_LIBRARY) {
    if (!entry.pattern.test(canonicalScript)) continue;
    found.push({
      id: entry.id,
      label: entry.label,
      source_text: entry.label,
      visual_metaphor: entry.visual_metaphor,
      connection_to_core_pattern: entry.connection_to_core_pattern,
    });
  }

  return found.slice(0, 6);
}

function normalizeVisualStoryScene(probe: EngineRenderableProbe): VisualStoryScene {
  const params: Record<string, unknown> = isRecord(probe.renderer_params)
    ? (probe.renderer_params as Record<string, unknown>)
    : {};
  const rawStory = isRecord(params.visual_story) ? params.visual_story : params;

  const rawSegments = Array.isArray(rawStory.orientation_segments) ? rawStory.orientation_segments : [];
  const segmentText = rawSegments
    .map((segment) => isRecord(segment) ? readOptionalString(segment.script_text ?? segment.text ?? segment.words, 600) : null)
    .filter((segment): segment is string => Boolean(segment))
    .join(" ");

  const rawCanonicalOrientationScript = readString(
    rawStory.canonical_orientation_script ??
      rawStory.teaching_script ??
      rawStory.orientation_text ??
      rawStory.orientationScript ??
      rawStory.script ??
      segmentText,
    readString(probe.prompt.reshaping_explanation || probe.prompt.full_prompt || probe.prompt.task, DEFAULT_CANONICAL_SCRIPT, 1100),
    1500,
  );
  const canonicalOrientationScript = stripRecapText(rawCanonicalOrientationScript);

  const lower = canonicalOrientationScript.toLowerCase();
  const sceneFamily = readString(
    rawStory.scene_family ?? rawStory.sceneFamily,
    /wheel|circle|sine|cosine|sin|cos|pi|π|wave|turn|graph/.test(lower) ? "motion_to_graph" : "generic_concept_scene",
    80,
  );

  const scriptBeats = normalizeScriptBeats(rawStory, canonicalOrientationScript);
  const sceneObjects = normalizeSceneObjects(rawStory, canonicalOrientationScript, sceneFamily);
  const sceneActions = normalizeSceneActions(rawStory, scriptBeats);
  const cameraPlan = normalizeCameraPlan(rawStory, scriptBeats);
  const interactionPhase = normalizeInteractionPhase(rawStory, sceneFamily);

  return {
    schema_version: readString(rawStory.schema_version, "visual_story_contract_v3", 80),
    title: readString(rawStory.title, probe.prompt.task || "Visual story", 160),
    canonical_orientation_script: canonicalOrientationScript,
    learning_goal: readString(rawStory.learning_goal ?? rawStory.story_goal, probe.prompt.reshaping_explanation || "Use the scene to make the idea visible.", 500),
    scene_family: sceneFamily,
    scene_kind: readString(rawStory.scene_kind ?? rawStory.sceneKind, sceneFamily === "motion_to_graph" ? "motion_to_graph" : "generic_concept_scene", 90),
    script_beats: scriptBeats.length ? scriptBeats : DEFAULT_SCRIPT_BEATS,
    scene_objects: sceneObjects,
    scene_actions: sceneActions,
    camera_plan: cameraPlan,
    interaction_phase: interactionPhase,
    learner_check: {
      kind: interactionPhase.mode,
      instructions: interactionPhase.instructions,
    },
    success_criteria: normalizeSuccessCriteria(rawStory),
    example_echoes: normalizeExampleEchoes(rawStory, canonicalOrientationScript),
  };
}

export function hasVisualStoryContract(probe: EngineRenderableProbe) {
  const params: Record<string, unknown> = isRecord(probe.renderer_params)
    ? (probe.renderer_params as Record<string, unknown>)
    : {};

  const story = isRecord(params.visual_story) ? params.visual_story : params;

  return (
    isRecord(params.visual_story) ||
    typeof story.canonical_orientation_script === "string" ||
    typeof story.orientation_text === "string" ||
    Array.isArray(story.script_beats) ||
    Array.isArray(story.scene_objects) ||
    story.scene_kind === "wheel_to_wave" ||
    story.sceneKind === "wheel_to_wave"
  );
}

function totalDuration(beats: VisualScriptBeat[]) {
  return beats.reduce((sum, beat) => sum + beat.duration_ms, 0);
}

function beatInfo(beats: VisualScriptBeat[], playheadMs: number) {
  let cursor = 0;

  for (let index = 0; index < beats.length; index += 1) {
    const beat = beats[index];
    const nextCursor = cursor + beat.duration_ms;

    if (playheadMs <= nextCursor || index === beats.length - 1) {
      const localProgress = clamp((playheadMs - cursor) / Math.max(1, beat.duration_ms));
      return { beat, index, localProgress };
    }

    cursor = nextCursor;
  }

  const lastBeat = beats[beats.length - 1] ?? DEFAULT_SCRIPT_BEATS[DEFAULT_SCRIPT_BEATS.length - 1];
  return { beat: lastBeat, index: Math.max(0, beats.length - 1), localProgress: 1 };
}

function revealText(text: string, progress: number) {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length <= 4) return text;
  const visibleCount = Math.max(2, Math.ceil(words.length * clamp((progress - 0.04) / 0.68)));
  return words.slice(0, visibleCount).join(" ");
}

function objectPosition(object: VisualSceneObject, index: number): [number, number, number] {
  if (object.position) return object.position;
  const columns = 4;
  const col = index % columns;
  const row = Math.floor(index / columns);
  return [-2.8 + col * 1.85, 0.85 - row * 1.35, 0];
}

function objectScale(object: VisualSceneObject): [number, number, number] {
  return object.scale ?? [1, 1, 1];
}

function emphasisOpacity(object: VisualSceneObject, activeBeat: VisualScriptBeat, globalProgress: number) {
  const focused = activeBeat.focus_object_ids.includes(object.id) || activeBeat.script_text.toLowerCase().includes(String(object.label ?? object.id).toLowerCase());
  const base = object.initial_state?.opacity ?? 0.72;
  const visibleProgress = clamp(globalProgress * 1.5);
  return clamp((focused ? 1 : base) * visibleProgress, 0.18, 1);
}

function LinePath({
  points,
  color,
  opacity = 1,
  lineWidth = 1,
}: {
  points: THREE.Vector3[];
  color: string;
  opacity?: number;
  lineWidth?: number;
}) {
  const geometry = useMemo(() => new THREE.BufferGeometry().setFromPoints(points), [points]);
  const material = useMemo(
    () => new THREE.LineBasicMaterial({ color, transparent: true, opacity, linewidth: lineWidth }),
    [color, opacity, lineWidth],
  );
  const line = useMemo(() => new THREE.Line(geometry, material), [geometry, material]);

  useEffect(() => {
    return () => {
      geometry.dispose();
      material.dispose();
    };
  }, [geometry, material]);

  return <primitive object={line} />;
}

function CameraRig({ scene, progress, activeIndex }: { scene: VisualStoryScene; progress: number; activeIndex: number }) {
  const { camera } = useThree();

  useFrame(() => {
    const t = easeInOut(progress);
    const activeCamera = scene.camera_plan.find((cameraBeat) => cameraBeat.beat_id === scene.script_beats[activeIndex]?.id);

    if (activeCamera?.view?.position) {
      const [x, y, z] = activeCamera.view.position;
      camera.position.lerp(new THREE.Vector3(x, y, z), 0.045);
      const lookAt = activeCamera.view.look_at ?? [0, 0.1, 0];
      camera.lookAt(lookAt[0], lookAt[1], lookAt[2]);
      camera.updateProjectionMatrix();
      return;
    }

    const beatCount = Math.max(1, scene.script_beats.length - 1);
    const beatT = clamp(activeIndex / beatCount);
    const motionScene = scene.scene_family === "motion_to_graph" || scene.scene_kind.includes("wave");
    const yaw = motionScene ? -0.56 + t * 0.44 : -0.34 + Math.sin(beatT * Math.PI) * 0.34;
    const height = motionScene ? 3.1 - Math.sin(t * Math.PI) * 0.48 : 3.25 - Math.sin(beatT * Math.PI) * 0.42;
    const distance = motionScene ? 7.8 - Math.sin(t * Math.PI) * 1.1 : 7.2 - Math.sin(beatT * Math.PI) * 0.92;
    const target = new THREE.Vector3(Math.sin(yaw) * distance, height, distance * Math.cos(yaw));

    camera.position.lerp(target, 0.045);
    camera.lookAt(0.1, 0.16, 0);
    camera.updateProjectionMatrix();
  });

  return null;
}

function WaveTrace({ progress, interactive, completedActionIds, onCompleteAction }: {
  progress: number;
  interactive: boolean;
  completedActionIds: string[];
  onCompleteAction: (actionId: string) => void;
}) {
  const baseX = 0.3;
  const baseY = -0.72;
  const width = 4.4;
  const amplitude = 0.86;
  const visible = clamp((progress - 0.32) / 0.46);
  const highlight = clamp((progress - 0.68) / 0.22);
  const periodDone = completedActionIds.includes("mark_one_repeat");
  const peakDone = completedActionIds.includes("tap_peak");

  const fullWave = useMemo(() => {
    const points: THREE.Vector3[] = [];
    for (let i = 0; i <= 180; i += 1) {
      const t = i / 180;
      points.push(new THREE.Vector3(baseX + t * width, baseY + Math.sin(t * Math.PI * 2) * amplitude, 0));
    }
    return points;
  }, []);

  const visibleWave = useMemo(() => {
    const samples = Math.max(2, Math.floor(180 * visible));
    const points: THREE.Vector3[] = [];
    for (let i = 0; i <= samples; i += 1) {
      const t = i / 180;
      points.push(new THREE.Vector3(baseX + t * width, baseY + Math.sin(t * Math.PI * 2) * amplitude, 0.04));
    }
    return points;
  }, [visible]);

  return (
    <group>
      <LinePath points={[new THREE.Vector3(baseX - 0.18, baseY, 0), new THREE.Vector3(baseX + width + 0.22, baseY, 0)]} color="#ffffff" opacity={0.22} />
      <LinePath points={[new THREE.Vector3(baseX, baseY - 1.05, 0), new THREE.Vector3(baseX, baseY + 1.05, 0)]} color="#ffffff" opacity={0.16} />
      <LinePath points={fullWave} color="#a78bfa" opacity={0.16} />
      <LinePath points={visibleWave} color="#fef3c7" opacity={0.98} />
      {highlight > 0 ? (
        <group>
          <LinePath points={[new THREE.Vector3(baseX, baseY - 1.16, 0.08), new THREE.Vector3(baseX + width, baseY - 1.16, 0.08)]} color="#fbbf24" opacity={0.35 + highlight * 0.6} />
          <mesh position={[baseX + width * 0.25, baseY + amplitude, 0.12]}>
            <sphereGeometry args={[0.08 + highlight * 0.035, 24, 24]} />
            <meshStandardMaterial color="#ffffff" emissive="#f59e0b" emissiveIntensity={1.4} roughness={0.2} />
          </mesh>
        </group>
      ) : null}
      {interactive ? (
        <group>
          <mesh position={[baseX + width / 2, baseY - 1.16, 0.18]} onClick={(event) => { event.stopPropagation(); onCompleteAction("mark_one_repeat"); }}>
            <boxGeometry args={[width, 0.22, 0.08]} />
            <meshStandardMaterial color={periodDone ? "#86efac" : "#fbbf24"} transparent opacity={periodDone ? 0.58 : 0.32} emissive={periodDone ? "#16a34a" : "#a16207"} emissiveIntensity={0.4} />
          </mesh>
          <mesh position={[baseX + width * 0.25, baseY + amplitude, 0.24]} onClick={(event) => { event.stopPropagation(); onCompleteAction("tap_peak"); }}>
            <sphereGeometry args={[peakDone ? 0.16 : 0.13, 32, 32]} />
            <meshStandardMaterial color={peakDone ? "#86efac" : "#ffffff"} emissive={peakDone ? "#22c55e" : "#f59e0b"} emissiveIntensity={1.4} roughness={0.18} />
          </mesh>
        </group>
      ) : null}
    </group>
  );
}

function WheelToWaveLayer({ progress, interactive, completedActionIds, onCompleteAction }: {
  progress: number;
  interactive: boolean;
  completedActionIds: string[];
  onCompleteAction: (actionId: string) => void;
}) {
  const wheelCenter = new THREE.Vector3(-2.55, 0.15, 0);
  const radius = 0.95;
  const angle = progress * Math.PI * 2.15 - Math.PI / 2;
  const dot = new THREE.Vector3(
    wheelCenter.x + Math.cos(angle) * radius,
    wheelCenter.y + Math.sin(angle) * radius,
    0.18,
  );
  const waveProgress = clamp((progress - 0.32) / 0.46);
  const waveX = 0.3 + waveProgress * 4.4;
  const waveY = -0.72 + Math.sin(waveProgress * Math.PI * 2) * 0.86;
  const projectionOpacity = clamp((progress - 0.14) / 0.22);
  const transferOpacity = clamp((progress - 0.34) / 0.2);
  const arcProgress = clamp((progress - 0.16) / 0.34);

  const arcPoints = useMemo(() => {
    const points: THREE.Vector3[] = [];
    const samples = Math.max(3, Math.floor(90 * arcProgress));
    for (let i = 0; i <= samples; i += 1) {
      const t = i / 90;
      const a = -Math.PI / 2 + t * Math.PI * 2;
      points.push(new THREE.Vector3(wheelCenter.x + Math.cos(a) * 1.13, wheelCenter.y + Math.sin(a) * 1.13, 0.12));
    }
    return points;
  }, [arcProgress]);

  return (
    <group>
      <mesh position={wheelCenter} rotation={[0, 0, angle]}>
        <torusGeometry args={[radius, 0.045, 24, 112]} />
        <meshStandardMaterial color="#a78bfa" emissive="#581c87" emissiveIntensity={0.5} roughness={0.35} />
      </mesh>
      <LinePath points={[new THREE.Vector3(wheelCenter.x - radius, wheelCenter.y, 0.05), new THREE.Vector3(wheelCenter.x + radius, wheelCenter.y, 0.05)]} color="#ddd6fe" opacity={0.22} />
      <LinePath points={[new THREE.Vector3(wheelCenter.x, wheelCenter.y - radius, 0.05), new THREE.Vector3(wheelCenter.x, wheelCenter.y + radius, 0.05)]} color="#ddd6fe" opacity={0.18} />
      {arcPoints.length > 2 ? <LinePath points={arcPoints} color="#fbbf24" opacity={0.72} /> : null}
      <mesh position={dot}>
        <sphereGeometry args={[0.105, 32, 32]} />
        <meshStandardMaterial color="#ffffff" emissive="#f59e0b" emissiveIntensity={1.75} roughness={0.2} />
      </mesh>
      <LinePath points={[dot, new THREE.Vector3(wheelCenter.x + 1.26, dot.y, 0.04)]} color="#fef3c7" opacity={0.18 + projectionOpacity * 0.58} />
      <LinePath points={[new THREE.Vector3(wheelCenter.x + 1.26, wheelCenter.y - radius, 0.02), new THREE.Vector3(wheelCenter.x + 1.26, wheelCenter.y + radius, 0.02)]} color="#fef3c7" opacity={0.1 + projectionOpacity * 0.32} />
      <WaveTrace progress={progress} interactive={interactive} completedActionIds={completedActionIds} onCompleteAction={onCompleteAction} />
      {transferOpacity > 0 ? (
        <LinePath points={[new THREE.Vector3(wheelCenter.x + 1.26, dot.y, 0.05), new THREE.Vector3(waveX, waveY, 0.05)]} color="#7dd3fc" opacity={transferOpacity * 0.48} />
      ) : null}
    </group>
  );
}

function materialForObject(object: VisualSceneObject, opacity: number, focused: boolean) {
  const emphasis = object.visual_style?.emphasis;
  const color = emphasis === "warning"
    ? "#fbbf24"
    : emphasis === "success"
      ? "#86efac"
      : emphasis === "glow" || focused
        ? "#fef3c7"
        : emphasis === "secondary"
          ? "#7dd3fc"
          : "#c4b5fd";
  const emissive = emphasis === "glow" || focused ? color : "#312e81";
  const emissiveIntensity = emphasis === "glow" || focused ? 0.95 : 0.26;

  return { color, emissive, emissiveIntensity, opacity };
}

function SceneObjectMesh({ object, index, activeBeat, progress, interactive, onCompleteAction }: {
  object: VisualSceneObject;
  index: number;
  activeBeat: VisualScriptBeat;
  progress: number;
  interactive: boolean;
  onCompleteAction: (actionId: string) => void;
}) {
  if (object.type === "wheel" || object.type === "dot" || object.type === "wave" || object.type === "arc") return null;

  const position = objectPosition(object, index);
  const scale = objectScale(object);
  const focused = activeBeat.focus_object_ids.includes(object.id) || activeBeat.script_text.toLowerCase().includes(String(object.label ?? object.id).toLowerCase());
  const opacity = emphasisOpacity(object, activeBeat, progress);
  const pulse = focused ? 1 + Math.sin(progress * Math.PI * 8) * 0.04 : 1;
  const material = materialForObject(object, opacity, focused);

  const clickActionId = object.role === "learner_target" ? "select_main_link" : "select_main_link";

  const commonProps = {
    position: position as [number, number, number],
    scale: [scale[0] * pulse, scale[1] * pulse, scale[2] * pulse] as [number, number, number],
    onClick: interactive ? (event: { stopPropagation: () => void }) => { event.stopPropagation(); onCompleteAction(clickActionId); } : undefined,
  };

  if (object.type === "plane" || object.type === "surface" || object.type === "container" || object.type === "bar") {
    return (
      <mesh {...commonProps}>
        <boxGeometry args={[1.1, object.type === "bar" ? 0.38 : 0.72, 0.08]} />
        <meshStandardMaterial color={material.color} emissive={material.emissive} emissiveIntensity={material.emissiveIntensity} transparent opacity={material.opacity} roughness={0.28} />
      </mesh>
    );
  }

  if (object.type === "connector" || object.type === "flow_path" || object.type === "line" || object.type === "arrow") {
    return <LinePath points={[new THREE.Vector3(position[0] - 0.55, position[1], position[2]), new THREE.Vector3(position[0] + 0.55, position[1], position[2])]} color={material.color} opacity={material.opacity} />;
  }

  return (
    <mesh {...commonProps}>
      <sphereGeometry args={[object.type === "highlight" ? 0.42 : 0.33, 32, 32]} />
      <meshStandardMaterial color={material.color} emissive={material.emissive} emissiveIntensity={material.emissiveIntensity} transparent opacity={material.opacity} roughness={0.22} />
    </mesh>
  );
}

function GenericConceptLayer({ scene, activeBeat, progress, interactive, onCompleteAction }: {
  scene: VisualStoryScene;
  activeBeat: VisualScriptBeat;
  progress: number;
  interactive: boolean;
  onCompleteAction: (actionId: string) => void;
}) {
  const objects = scene.scene_objects.filter((object) => object.type !== "label").slice(0, 14);

  const connectorPoints = objects.slice(0, -1).map((object, index) => {
    const from = objectPosition(object, index);
    const to = objectPosition(objects[index + 1], index + 1);
    return [new THREE.Vector3(from[0], from[1], from[2] - 0.05), new THREE.Vector3(to[0], to[1], to[2] - 0.05)];
  });

  return (
    <group>
      {connectorPoints.map((points, index) => (
        <LinePath key={`connector-${index}`} points={points} color="#7dd3fc" opacity={0.18 + clamp(progress) * 0.3} />
      ))}
      {objects.map((object, index) => (
        <SceneObjectMesh key={object.id} object={object} index={index} activeBeat={activeBeat} progress={progress} interactive={interactive} onCompleteAction={onCompleteAction} />
      ))}
    </group>
  );
}

function VisualStoryWorld({ scene, playheadMs, totalMs, activeIndex, interactive, completedActionIds, onCompleteAction }: {
  scene: VisualStoryScene;
  playheadMs: number;
  totalMs: number;
  activeIndex: number;
  interactive: boolean;
  completedActionIds: string[];
  onCompleteAction: (actionId: string) => void;
}) {
  const progress = clamp(playheadMs / Math.max(1, totalMs));
  const activeBeat = scene.script_beats[activeIndex] ?? scene.script_beats[0] ?? DEFAULT_SCRIPT_BEATS[0];
  const useMotionToGraph = scene.scene_family === "motion_to_graph" || scene.scene_kind.includes("wave") || scene.scene_objects.some((object) => object.type === "wheel" || object.type === "wave");

  return (
    <>
      <CameraRig scene={scene} progress={progress} activeIndex={activeIndex} />
      <color attach="background" args={["#070014"]} />
      <ambientLight intensity={0.72} />
      <directionalLight position={[4, 7, 6]} intensity={1.35} />
      <pointLight position={[-4, 2, 4]} intensity={0.65} color="#c4b5fd" />

      {useMotionToGraph ? (
        <WheelToWaveLayer progress={progress} interactive={interactive} completedActionIds={completedActionIds} onCompleteAction={onCompleteAction} />
      ) : (
        <GenericConceptLayer scene={scene} activeBeat={activeBeat} progress={progress} interactive={interactive} onCompleteAction={onCompleteAction} />
      )}
    </>
  );
}


function ExampleEchoPanel({ scene, progress, activePurpose }: { scene: VisualStoryScene; progress: number; activePurpose: string }) {
  const visible = scene.example_echoes.length > 0 && (progress > 0.72 || activePurpose === "real_life_relevance");
  if (!visible) return null;

  return (
    <div
      style={{
        pointerEvents: "none",
        position: "absolute",
        right: "clamp(0.85rem, 2.6vw, 1.6rem)",
        top: "clamp(6.2rem, 18vh, 8rem)",
        display: "grid",
        gap: "0.45rem",
        width: "min(12.5rem, 32vw)",
      }}
    >
      <p
        style={{
          margin: 0,
          color: "rgba(221,214,254,0.72)",
          fontSize: "0.62rem",
          fontWeight: 850,
          letterSpacing: "0.18em",
          textTransform: "uppercase",
        }}
      >
        same pattern shows up in
      </p>
      {scene.example_echoes.map((echo, index) => {
        const echoProgress = clamp((progress - 0.72 - index * 0.025) / 0.12);
        return (
          <div
            key={echo.id}
            style={{
              opacity: echoProgress,
              transform: "translateX(" + ((1 - easeInOut(echoProgress)) * 12) + "px)",
              border: "1px solid rgba(255,255,255,0.12)",
              borderRadius: "16px",
              background: "rgba(0,0,0,0.28)",
              backdropFilter: "blur(12px)",
              padding: "0.48rem 0.56rem",
            }}
          >
            <p style={{ margin: 0, color: "white", fontSize: "0.78rem", fontWeight: 900 }}>{echo.label}</p>
            <p style={{ margin: "0.15rem 0 0", color: "rgba(255,255,255,0.62)", fontSize: "0.68rem", lineHeight: 1.35 }}>
              {echo.visual_metaphor}
            </p>
          </div>
        );
      })}
    </div>
  );
}

export function VisualStoryProbe(props: GenericProbeComponentProps) {
  const scene = useMemo(() => normalizeVisualStoryScene(props.probe), [props.probe]);
  const totalMs = useMemo(() => totalDuration(scene.script_beats), [scene.script_beats]);
  const [playheadMs, setPlayheadMs] = useState(0);
  const [isPlaying, setIsPlaying] = useState(true);
  const [completedActionIds, setCompletedActionIds] = useState<string[]>([]);
  const [scrubProgress, setScrubProgress] = useState(1);
  const lastFrameRef = useRef<number | null>(null);
  const lastDraftTextRef = useRef<string>("");

  const done = playheadMs >= totalMs;
  const visualPlayheadMs = done ? totalMs * scrubProgress : playheadMs;
  const active = beatInfo(scene.script_beats, visualPlayheadMs);
  const requiredActionIds = scene.interaction_phase.required_actions.map((action) => action.id);
  const completionReady = requiredActionIds.every((id) => completedActionIds.includes(id));
  const interactive = done && !props.disabled;
  const revealedText = revealText(active.beat.display_text ?? active.beat.script_text, active.localProgress);

  useEffect(() => {
    if (!isPlaying || props.disabled) {
      lastFrameRef.current = null;
      return;
    }

    let frameId = 0;

    const tick = (now: number) => {
      const last = lastFrameRef.current ?? now;
      const delta = Math.min(80, Math.max(0, now - last));
      lastFrameRef.current = now;

      setPlayheadMs((current) => {
        const next = Math.min(totalMs, current + delta);
        if (next >= totalMs) setIsPlaying(false);
        return next;
      });

      frameId = window.requestAnimationFrame(tick);
    };

    frameId = window.requestAnimationFrame(tick);
    return () => window.cancelAnimationFrame(frameId);
  }, [isPlaying, props.disabled, totalMs]);

  useEffect(() => {
    const payload = {
      visual_story_completed: completionReady,
      visual_story_schema_version: scene.schema_version,
      visual_story_scene_family: scene.scene_family,
      visual_story_completed_action_ids: completedActionIds,
      visual_story_required_action_ids: requiredActionIds,
      visual_story_title: scene.title,
      canonical_orientation_script: scene.canonical_orientation_script,
      elapsed_seconds: Math.round(playheadMs / 1000),
    };

    const nextText = completionReady ? JSON.stringify(payload) : "";

    if (lastDraftTextRef.current === nextText) return;
    lastDraftTextRef.current = nextText;

    props.onDraftChange({
      ...props.draft,
      attempt_type: "text",
      text_response: nextText,
      generated_video_completed: completionReady,
      generated_video_elapsed_seconds: Math.round(playheadMs / 1000),
      visual_story_completed: completionReady,
      visual_story_scene_family: scene.scene_family,
      visual_story_completed_action_ids: completedActionIds,
      visual_story_interaction_notes: completionReady ? `Completed visual story interaction for ${scene.title}.` : "",
    });
    // Only publish a new answer when learner check state changes.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [completionReady, completedActionIds.join("|"), scene.schema_version, scene.scene_family, scene.title, scene.canonical_orientation_script]);

  function completeAction(actionId: string) {
    setCompletedActionIds((current) => current.includes(actionId) ? current : [...current, actionId]);
  }

  function replay() {
    setPlayheadMs(0);
    setIsPlaying(true);
    setCompletedActionIds([]);
    setScrubProgress(1);
    lastFrameRef.current = null;
  }

  return (
    <section
      aria-label="Visual story probe"
      style={{
        position: "relative",
        minHeight: "min(74vh, 760px)",
        overflow: "hidden",
        borderRadius: "30px",
        border: "1px solid rgba(255,255,255,0.12)",
        background: "radial-gradient(circle at 30% 20%, rgba(168,85,247,0.28), transparent 36%), linear-gradient(145deg, rgba(6,6,19,0.96), rgba(35,10,60,0.92))",
        boxShadow: "0 28px 90px rgba(0,0,0,0.38)",
      }}
    >
      <Canvas
        camera={{ position: [0, 3.2, 7.4], fov: 43, near: 0.1, far: 100 }}
        dpr={[1, 1.75]}
        style={{ position: "absolute", inset: 0, width: "100%", height: "100%" }}
      >
        <VisualStoryWorld
          scene={scene}
          playheadMs={visualPlayheadMs}
          totalMs={totalMs}
          activeIndex={active.index}
          interactive={interactive}
          completedActionIds={completedActionIds}
          onCompleteAction={completeAction}
        />
      </Canvas>

      <div
        style={{
          pointerEvents: "none",
          position: "absolute",
          inset: 0,
          background: "radial-gradient(circle at center, transparent 42%, rgba(0,0,0,0.24) 100%)",
        }}
      />

      <div
        style={{
          pointerEvents: "none",
          position: "absolute",
          left: "50%",
          top: "clamp(0.75rem, 2vw, 1.15rem)",
          width: "min(760px, calc(100% - 2rem))",
          transform: `translateX(-50%) translateY(${(1 - easeInOut(active.localProgress)) * 8}px)`,
          opacity: 0.7 + easeInOut(active.localProgress) * 0.3,
          padding: "0.72rem 0.9rem",
          border: "1px solid rgba(255,255,255,0.13)",
          borderRadius: "22px",
          background: "linear-gradient(135deg, rgba(10,8,24,0.68), rgba(34,12,62,0.42))",
          backdropFilter: "blur(16px)",
          boxShadow: "0 18px 52px rgba(0,0,0,0.28)",
        }}
      >
      </div>

      <ExampleEchoPanel scene={scene} progress={visualPlayheadMs / Math.max(1, totalMs)} activePurpose={String(active.beat.purpose)} />

      <div
        style={{
          position: "absolute",
          right: "clamp(1rem, 3vw, 2rem)",
          top: "clamp(1rem, 3vw, 2rem)",
          display: "flex",
          gap: "0.5rem",
          flexWrap: "wrap",
          justifyContent: "flex-end",
        }}
      >
        <button
          type="button"
          disabled={props.disabled || done}
          onClick={() => setIsPlaying((value) => !value)}
          style={controlButtonStyle}
        >
          {isPlaying ? "Pause" : done ? "Finished" : "Play"}
        </button>
        <button type="button" disabled={props.disabled} onClick={replay} style={controlButtonStyle}>
          Replay
        </button>
      </div>

      <div
        style={{
          position: "absolute",
          left: "clamp(1rem, 3vw, 2rem)",
          right: "clamp(1rem, 3vw, 2rem)",
          bottom: "clamp(1rem, 3vw, 2rem)",
          display: "grid",
          gap: "0.75rem",
        }}
      >
        <div style={{ height: "0.48rem", overflow: "hidden", borderRadius: "999px", background: "rgba(255,255,255,0.1)" }}>
          <div
            style={{
              height: "100%",
              width: `${Math.round((visualPlayheadMs / Math.max(1, totalMs)) * 100)}%`,
              borderRadius: "999px",
              background: "linear-gradient(90deg, rgba(168,85,247,0.95), rgba(251,191,36,0.95))",
              transition: isPlaying ? "none" : "width 280ms ease",
            }}
          />
        </div>

        {done ? (
          <div
            style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              gap: "0.8rem",
              flexWrap: "wrap",
              border: "1px solid rgba(255,255,255,0.12)",
              borderRadius: "22px",
              background: "rgba(0,0,0,0.34)",
              padding: "0.75rem",
              backdropFilter: "blur(16px)",
            }}
          >
            <div style={{ minWidth: 0 }}>
              <p style={{ margin: 0, color: "rgba(255,255,255,0.9)", fontSize: "0.88rem", fontWeight: 850 }}>
                Now use the scene
              </p>
              <p style={{ margin: "0.25rem 0 0", color: "rgba(255,255,255,0.72)", fontSize: "0.82rem", lineHeight: 1.5 }}>
                {scene.interaction_phase.instructions}
              </p>
              <div style={{ marginTop: "0.55rem", display: "flex", alignItems: "center", gap: "0.65rem", flexWrap: "wrap" }}>
                <span style={{ color: "rgba(255,255,255,0.72)", fontSize: "0.72rem", fontWeight: 850, letterSpacing: "0.08em", textTransform: "uppercase" }}>
                  scrub motion
                </span>
                <input
                  aria-label="Scrub visual story motion"
                  type="range"
                  min={0}
                  max={100}
                  value={Math.round(scrubProgress * 100)}
                  onChange={(event) => {
                    setScrubProgress(Number(event.currentTarget.value) / 100);
                    completeAction("scrub_motion");
                  }}
                  style={{ width: "min(22rem, 58vw)", accentColor: "#fbbf24" }}
                />
              </div>
            </div>
            <div style={{ display: "flex", gap: "0.5rem", flexWrap: "wrap" }}>
              {scene.interaction_phase.required_actions.map((action) => {
                const completed = completedActionIds.includes(action.id);
                return (
                  <button
                    key={action.id}
                    type="button"
                    disabled={props.disabled}
                    onClick={() => completeAction(action.id)}
                    style={completed ? successButtonStyle : controlButtonStyle}
                  >
                    {completed ? `${action.label} ✓` : action.label}
                  </button>
                );
              })}
            </div>
          </div>
        ) : null}
      </div>
    </section>
  );
}

const controlButtonStyle = {
  border: "1px solid rgba(255,255,255,0.16)",
  borderRadius: "999px",
  background: "rgba(255,255,255,0.1)",
  color: "white",
  padding: "0.58rem 0.85rem",
  fontSize: "0.78rem",
  fontWeight: 850,
  cursor: "pointer",
  backdropFilter: "blur(12px)",
} satisfies CSSProperties;

const successButtonStyle = {
  ...controlButtonStyle,
  border: "1px solid rgba(187,247,208,0.34)",
  background: "rgba(34,197,94,0.2)",
} satisfies CSSProperties;