  {
    id: "wheel-picture",
    title: "Picture the turn",
    script_text: "A good first picture is a wheel turning.",
    purpose: "setup",
    visual_goal: "Introduce the wheel as the real-world anchor.",
    duration_ms: 4800,
    focus_object_ids: ["wheel", "tracked_dot"],
    action_ids: ["show_wheel", "start_spin"],
  },
  {
    id: "pi-turn-measure",
    title: "Pi measures the turn",
    script_text: "Pi measures how far around the turn you are.",
    purpose: "measurement",
    visual_goal: "Show turn amount as an arc around the wheel.",
    duration_ms: 5600,
    focus_object_ids: ["wheel", "turn_arc", "pi_label"],
    action_ids: ["draw_turn_arc", "show_pi_label"],
  },
  {
    id: "half-full-turn",
    title: "Half turn and full turn",
    script_text: "Half a turn is π, and a full turn is 2π.",
    purpose: "measurement",
    visual_goal: "Highlight half turn and one full turn.",
    duration_ms: 6200,
    focus_object_ids: ["turn_arc", "pi_label", "two_pi_label"],
    action_ids: ["highlight_half_turn", "highlight_full_turn"],
  },
  {
    id: "track-height",
    title: "Track one part",
    script_text: "Sine can track the height of a point on the wheel.",
    purpose: "mapping",
    visual_goal: "Track the dot's height as it moves.",
    duration_ms: 6200,
    focus_object_ids: ["tracked_dot", "height_guide"],
