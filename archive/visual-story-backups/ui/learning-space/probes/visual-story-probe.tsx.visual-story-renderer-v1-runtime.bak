"use client";

import { useEffect, useMemo, useRef, useState, type CSSProperties } from "react";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import * as THREE from "three";
import type { EngineRenderableProbe } from "@/lib/engine";
import type { GenericProbeComponentProps } from "./probe-ui-types";

type VisualStoryPurpose =
  | "setup"
  | "real_world_anchor"
  | "mechanism"
  | "mapping"
  | "measurement"
  | "contrast"
  | "prediction"
  | "real_life_relevance"
  | "transition_to_check"
  | string;

type VisualSceneFamily =
  | "motion_to_graph"
  | "mechanism"
  | "process_flow"
  | "compare_contrast"
  | "spatial_structure"
  | "quantity_change"
  | "cause_effect"
  | "classification_boundary"
  | "generic_concept_scene"
  | string;

type VisualSceneObjectType =
  | "wheel"
  | "dot"
  | "arc"
  | "axis"
  | "graph"
  | "wave"
  | "line"
  | "guide_line"
  | "arrow"
  | "label"
  | "point"
  | "vector"
  | "surface"
  | "plane"
  | "slice"
  | "bar"
  | "container"
  | "token"
  | "flow_path"
  | "node"
  | "connector"
  | "highlight"
  | "generic"
  | string;

type VisualScriptBeat = {
  id: string;
  title: string;
  script_text: string;
  display_text?: string | null;
  purpose: VisualStoryPurpose;
  visual_goal: string;
  duration_ms: number;
  focus_object_ids: string[];
  action_ids: string[];
};

type VisualSceneObject = {
  id: string;
  type: VisualSceneObjectType;
  role: string;
  label?: string | null;
  text?: string | null;
  parent_id?: string | null;
  position?: [number, number, number] | null;
  scale?: [number, number, number] | null;
  initial_state?: {
    visible?: boolean;
    opacity?: number;
    rotation?: [number, number, number];
  } | null;
  visual_style?: {
    emphasis?: "primary" | "secondary" | "muted" | "glow" | "warning" | "success" | string;
  } | null;
};

type VisualSceneAction = {
  id: string;
  beat_id: string;
  type: string;
  target_id?: string | null;
  from_id?: string | null;
  to_id?: string | null;
  start_ms?: number;
  duration_ms: number;
  easing?: string | null;
  params?: Record<string, unknown> | null;
};

type VisualCameraBeat = {
  id: string;
  beat_id: string;
  target_object_ids: string[];
  move: string;
  duration_ms: number;
  easing?: string | null;
  view?: {
    position?: [number, number, number];
    look_at?: [number, number, number];
    zoom?: number;
  } | null;
};

type VisualRequiredAction = {
  id: string;
  type: string;
  target_id?: string | null;
  success_marker: string;
  label: string;
};

type VisualInteractionPhase = {
  unlock_after: "animation_complete" | string;
  instructions: string;
  mode: string;
  required_actions: VisualRequiredAction[];
  submit_when: "all_required_actions_complete" | "learner_clicks_submit" | string;
};

type VisualSuccessCriterion = {
  id: string;
  marker: string;
  description?: string | null;
};

type VisualExampleEcho = {
  id: string;
  label: string;
  source_text: string;
  visual_metaphor: string;
  connection_to_core_pattern: string;
};

type VisualStoryScene = {
  schema_version: "visual_story_contract_v2" | "visual_story_contract_v3" | string;
  title: string;
  canonical_orientation_script: string;
  learning_goal: string;
  scene_family: VisualSceneFamily;
  scene_kind: string;
  script_beats: VisualScriptBeat[];
  scene_objects: VisualSceneObject[];
  scene_actions: VisualSceneAction[];
  camera_plan: VisualCameraBeat[];
  interaction_phase: VisualInteractionPhase;
  learner_check: {
    kind: string;
    instructions: string;
  };
  success_criteria: VisualSuccessCriterion[];
  example_echoes: VisualExampleEcho[];
};

