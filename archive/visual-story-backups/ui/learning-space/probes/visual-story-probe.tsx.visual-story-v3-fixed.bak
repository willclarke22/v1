"use client";

import { useEffect, useMemo, useRef, useState, type CSSProperties } from "react";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { OrbitControls } from "@react-three/drei";
import * as THREE from "three";
import type { EngineRenderableProbe } from "@/lib/engine";
import type { GenericProbeComponentProps } from "./probe-ui-types";

type VisualSceneObjectType =
  | "wheel"
  | "dot"
  | "wave"
  | "axis"
  | "guide_line"
  | "connector"
  | "highlight"
  | "marker"
  | "label"
  | "plane"
  | "surface"
  | "generic";

type VisualSceneObject = {
  id: string;
  type: VisualSceneObjectType;
  label?: string;
  role?: string;
  parent?: string;
  position?: [number, number, number];
  color?: string;
  radius?: number;
};

type VisualStoryActionType =
  | "show"
  | "hide"
  | "spin"
  | "trace_height"
  | "draw_wave"
  | "highlight_period"
  | "highlight_peak"
  | "connect"
  | "pulse"
  | "focus_camera"
  | "enable_interaction";

type VisualStoryAction = {
  type: VisualStoryActionType;
  target?: string;
  text?: string;
  speed?: number;
};

type VisualStoryBeat = {
  id: string;
  title: string;
  words: string;
  duration_ms: number;
  actions: VisualStoryAction[];
};

type VisualStoryInteractionPhase = {
  unlock_after: "animation_complete" | string;
  instructions: string;
  required_actions: Array<{
    id: string;
    type: "mark_repeat" | "tap_peak" | "scrub_motion" | "select_object" | string;
    target?: string;
    label?: string;
  }>;
};

type VisualStoryOrientationSegment = {
  id: string;
  text: string;
  beat_id?: string;
  title?: string;
  emphasis?: string;
};

type VisualStoryScene = {
  scene_kind: string;
  story_goal: string;
  orientation_text: string;
  orientation_segments: VisualStoryOrientationSegment[];
  objects: VisualSceneObject[];
  beats: VisualStoryBeat[];
  interaction_phase: VisualStoryInteractionPhase;
  learner_check: {
    kind: string;
    instructions: string;
  };
};

