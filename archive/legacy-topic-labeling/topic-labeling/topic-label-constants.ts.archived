export const FOCUS_MARKER_REGEX =
  /\b(mainly|mostly|especially|specifically|particularly|the part|the thing|the bit|most of all|primarily|exactly|real issue|actual issue|real problem|actual problem|real bottleneck|main bottleneck|actual blocker|the blocker|specific point|specific thing|what i actually|what i really|right now|the target|the actual target|what keeps|throwing me off|tripping me up|where i start|get stuck on|stuck on|not vocab|not the general|not really what)\b/i;

